{
  "expo": {
    "name": "Syncnox",
    "slug": "syncnox-driver-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/syncnox-icon-padded.png",
    "scheme": "syncnoxdriverapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohsinali530121.syncnoxdriverapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/syncnox-android-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/syncnox-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mohsinali530121.syncnoxdriverapp",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAUOmd-oe3hRx0ZmxQhfOD8ufgGIHRt8Ag"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        },
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e5268cb-bd88-4cea-bcf6-103f516e2e0f"
      }
    }
  }
}
